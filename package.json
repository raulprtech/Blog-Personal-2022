{
  "name": "portfolio-blog",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "start": "next start",
    "dev": "next dev --webpack",
    "build": "node ./scripts/generate-site-icons && next build --webpack",
    "serve": "next start",
    "studio:install": "cd studio && pnpm install",
    "studio:dev": "cd studio && pnpm run dev",
    "studio:deploy": "cd studio && pnpm run deploy",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "lint": "eslint pages components lib layouts scripts sanity tests",
    "test": "node --test tests/*.test.cjs",
    "check:secrets": "node scripts/check-secrets.cjs",
    "prepare": "husky install"
  },
  "dependencies": {
    "@fontsource/inter": "4.5.14",
    "@giscus/react": "^2.4.0",
    "@sanity/webhook": "4.0.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.13.15",
    "github-slugger": "^1.5.0",
    "gray-matter": "^4.0.3",
    "image-size": "2.0.3",
    "js-yaml": "3.15.2",
    "katex": "0.16.47",
    "mdast-util-to-string": "3.2.0",
    "mdx-bundler": "^8.1.0",
    "next": "16.3.8",
    "next-themes": "^0.2.1",
    "postcss": "8.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reading-time": "1.3.0",
    "rehype-autolink-headings": "^6.1.1",
    "rehype-citation": "^0.4.0",
    "rehype-katex": "^6.0.3",
    "rehype-preset-minify": "6.0.0",
    "rehype-prism-plus": "^1.6.3",
    "rehype-slug": "^5.1.0",
    "remark-footnotes": "^4.0.1",
    "remark-gfm": "^3.0.1",
    "remark-math": "^5.1.1",
    "sharp": "0.35.5",
    "tailwindcss": "^3.4.19",
    "unist-util-visit": "^4.1.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.8",
    "@svgr/webpack": "^6.5.1",
    "cross-env": "^7.0.3",
    "dedent": "^0.7.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "file-loader": "^6.2.0",
    "globby": "11.0.3",
    "husky": "^6.0.0",
    "inquirer": "^8.2.7",
    "lint-staged": "^11.2.6",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.1.13",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882"
